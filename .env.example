# Authentication (generate a long random value; never commit the real secret)
JWT_SECRET=replace-with-at-least-32-random-characters

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=simple_ledger
DB_USER=root
DB_PASSWORD=secret
DB_SSLMODE=disable

# Server
PORT=8080
# Host port for the Docker Compose backend (container port remains 8080).
BACKEND_PORT=8383
# Optional public API origin used by Swagger UI; omit to use the current origin.
SWAGGER_BASE_URL=

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Fictional local demo data. Never reuse these public credentials elsewhere.
# Customers: helga.müller@pehlione.com, jonas.schneider@pehlione.com,
#            sofia.wagner@pehlione.com
DEMO_SEED=true
DEMO_SEED_PASSWORD=DemoBank2026!Abc

# Fictional local administrator account.
ADMIN_SEED_EMAIL=admin@pehlione.com
ADMIN_SEED_PASSWORD=AdminBank2026!Xy

# Free/demo profile: scheduler runs only while the web process is awake
ENABLE_IN_PROCESS_SCHEDULER=true
RUN_DB_MIGRATIONS_ON_START=true

# Private Banking API -> Notification service authentication.
# Generate independently, for example: openssl rand -base64 32
NOTIFICATION_SERVICE_TOKEN=replace-with-at-least-32-random-characters
NOTIFICATION_SERVICE_URL=http://localhost:8490
NOTIFICATION_HTTP_PORT=8490
NOTIFICATION_DELIVERY_TIMEOUT=12s

# Notification service delivery configuration. Local Compose defaults SMTP_HOST
# to MailHog; a hosted environment can instead use Resend's HTTPS API.
RESEND_API_KEY=
MAIL_FROM=Pehlione DemoBank <banking@pehlione.com>
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILHOG_HTTP_PORT=8425
