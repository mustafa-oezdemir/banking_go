# Authentication (generate a long random value; never commit the real secret)
JWT_SECRET=replace-with-at-least-32-random-characters

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=simple_ledger
DB_USER=root
DB_PASSWORD=secret
DB_SSLMODE=disable

# Server
PORT=8080

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo data is opt-in and idempotent
DEMO_SEED=false
# Required only when DEMO_SEED=true; use a unique 15-72 byte secret.
DEMO_SEED_PASSWORD=

# Optional production administrator bootstrap (both values are required together).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Free/demo profile: scheduler runs only while the web process is awake
ENABLE_IN_PROCESS_SCHEDULER=true
RUN_DB_MIGRATIONS_ON_START=true

# Local development uses MailHog through SMTP_HOST=mailhog in docker-compose.dev.yml.
# Production uses Resend's HTTPS API because SMTP is blocked on Render free.
RESEND_API_KEY=
MAIL_FROM=Pehlione DemoBank <banking@pehlione.com>
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILHOG_HTTP_PORT=8425
